{
    "compilerOptions": {
        "target": "es2025",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
    },
    "ts-node": {
        "esm": true
    },
    "include": [
        "src",
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}